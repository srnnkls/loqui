#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["tomlkit>=0.13"]
# ///
"""Loqui project tooling.

`loqui init LAYER...` binds the current project to loqui blueprints: it writes
each layer's `blueprints/<layer>/phora.toml` into the project's `phora.toml`,
pins every loqui source to the commit this script runs from, copies scaffold
files the project lacks, writes `hk.pkl` when absent, and runs `phora sync`.

`loqui update` does the same for the layers the project already binds, so a
project picks up the blueprints of the commit this script runs from.

`loqui merge-lints [--check]` reconciles a Cargo manifest's lint table with the
deployed `.loqui/rust/lints.toml`.
"""

import argparse
import re
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

import tomlkit
from tomlkit.items import Table
from tomlkit.toml_document import TOMLDocument

LOQUI_ROOT = Path(__file__).resolve().parents[1]
BLUEPRINTS = LOQUI_ROOT / "blueprints"
MERGE_LINTS = BLUEPRINTS / "rust" / "merge-lints"
REF_KEYS = ("branch", "tag", "rev")
LANGUAGES = ("rust", "python", "go", "elisp", "zig", "bash")
LAYERS = (*LANGUAGES, "rust-release")
LOQUI_TARGET = "loqui"
SOURCE_PREFIX = "loqui-"
GIT = shutil.which("git") or "git"
HK_CONFIG = "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"


class InitError(Exception):
    """Initialization cannot proceed."""


class MalformedVarError(InitError):
    """A `--var` argument is not `NAME=VALUE`."""

    def __init__(self, assignment: str) -> None:
        """Name the malformed ASSIGNMENT."""
        super().__init__(f"--var expects NAME=VALUE, got {assignment!r}")


class MissingVarError(InitError):
    """A blueprint var has neither a project value nor a default."""

    def __init__(self, name: str) -> None:
        """Name the var NAME and how to supply it."""
        super().__init__(f"blueprint var {name!r} has no value; pass --var {name}=...")


class NotACheckoutError(InitError):
    """`--local` needs loqui as a git checkout, not an installed copy."""

    def __init__(self) -> None:
        """Name the directory that is not a checkout."""
        super().__init__(f"--local needs a loqui git checkout; {LOQUI_ROOT} is not one")


class NotBoundError(InitError):
    """`loqui update` needs a project `loqui init` bound."""

    def __init__(self) -> None:
        """Name the command that binds a project."""
        super().__init__("the project binds no loqui layer; run `loqui init LAYER...` first")


class CommandError(InitError):
    """A setup command exited non-zero."""

    def __init__(self, command: list[str], returncode: int) -> None:
        """Name COMMAND and its RETURNCODE."""
        super().__init__(f"`{' '.join(command)}` exited {returncode}")


@dataclass(frozen=True, kw_only=True)
class Request:
    """The layers, vars, and source mode one invocation asks for."""

    layers: tuple[str, ...]
    variables: dict[str, str]
    local: bool


@dataclass(frozen=True, kw_only=True)
class MergeLintsRequest:
    """A lint-table reconciliation, checking only when CHECK."""

    check: bool


def parse_request(argv: list[str]) -> Request | MergeLintsRequest:
    """Parse ARGV into a request."""
    parser = argparse.ArgumentParser(prog="loqui", description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    init = commands.add_parser("init", help="bind the current project to loqui blueprints")
    init.add_argument("layers", nargs="+", choices=LAYERS)
    update = commands.add_parser(
        "update", help="move the project's blueprints to this runner's commit"
    )
    for command in (init, update):
        command.add_argument(
            "--var",
            action="append",
            default=[],
            metavar="NAME=VALUE",
            help="set a blueprint var, e.g. go_module=github.com/you/project",
        )
        command.add_argument(
            "--local",
            action="store_true",
            help=f"bind the committed HEAD of the loqui checkout at {LOQUI_ROOT} "
            "through phora.local.toml",
        )
    merge_lints = commands.add_parser(
        "merge-lints",
        help="write .loqui/rust/lints.toml into the Cargo manifest's lint table",
    )
    merge_lints.add_argument("--check", action="store_true", help="report drift without writing")
    args = parser.parse_args(argv)
    if args.command == "merge-lints":
        return MergeLintsRequest(check=args.check)
    variables: dict[str, str] = {}
    for assignment in args.var:
        name, separator, value = assignment.partition("=")
        if not separator or not name:
            raise MalformedVarError(assignment)
        variables[name] = value
    return Request(
        layers=tuple(dict.fromkeys(getattr(args, "layers", ()))),
        variables=variables,
        local=args.local,
    )


def read_document(path: Path) -> TOMLDocument:
    """Parse the TOML file at PATH, or return an empty document when it is absent."""
    if not path.exists():
        return tomlkit.document()
    return tomlkit.parse(path.read_text(encoding="utf-8"))


def detected_variables(project: Path) -> dict[str, str]:
    """Return blueprint vars the PROJECT's manifests already determine."""
    go_mod = project / "go.mod"
    if not go_mod.is_file():
        return {}
    match = re.search(r"^module\s+(\S+)", go_mod.read_text(encoding="utf-8"), re.MULTILINE)
    return {"go_module": match.group(1)} if match else {}


def merge_hooks(hooks: Table, fragment_hooks: Table) -> None:
    """Add FRAGMENT_HOOKS' commands to HOOKS, keeping their order."""
    for event, commands in fragment_hooks.items():
        merged = hooks.setdefault(event, tomlkit.array())
        for command in commands:
            if command not in merged:
                merged.append(command)


def bound_layers(config: TOMLDocument) -> tuple[str, ...]:
    """Return the loqui layers CONFIG binds, without `common`."""
    names = config.get("sources", {}).keys()
    layers = (name.removeprefix(SOURCE_PREFIX) for name in names if name.startswith(SOURCE_PREFIX))
    return tuple(layer for layer in layers if layer in LAYERS)


def clear_loqui(config: TOMLDocument) -> None:
    """Drop the loqui sources and the loqui target from CONFIG; loqui writes them whole."""
    sources = config.get("sources", {})
    for name in [name for name in sources if name.startswith(SOURCE_PREFIX)]:
        del sources[name]
    config.get("targets", {}).pop(LOQUI_TARGET, None)


def dump_tidy(config: TOMLDocument) -> str:
    """Return CONFIG as TOML with exactly one blank line before each table."""
    spaced = re.sub(r"([^\n])\n\[", r"\1\n\n[", tomlkit.dumps(config))
    return re.sub(r"\n{3,}", "\n\n", spaced).lstrip("\n")


def merge_fragment(config: TOMLDocument, fragment: TOMLDocument, variables: dict[str, str]) -> None:
    """Write a blueprint FRAGMENT's loqui entries into CONFIG, keeping project vars."""
    sources = config.setdefault("sources", tomlkit.table())
    for name, source in fragment["sources"].items():
        sources[name] = source

    targets = config.setdefault("targets", tomlkit.table(is_super_table=True))
    for name, fragment_target in fragment["targets"].items():
        target = targets.setdefault(name, tomlkit.table())
        target.setdefault("path", fragment_target["path"])
        bindings = target.setdefault("sources", tomlkit.table())
        for binding, refinement in fragment_target["sources"].items():
            bindings[binding] = refinement
        if "hooks" in fragment_target:
            merge_hooks(target.setdefault("hooks", tomlkit.table()), fragment_target["hooks"])

    for name, default in fragment.get("vars", {}).items():
        project_vars = config.setdefault("vars", tomlkit.table())
        if name in project_vars:
            continue
        value = variables.get(name, default)
        if not value:
            raise MissingVarError(name)
        project_vars[name] = value


def git_output(args: list[str]) -> str:
    """Return the stripped stdout of `git ARGS` run in the loqui checkout."""
    command = [GIT, "-C", str(LOQUI_ROOT), *args]
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    if result.returncode != 0:
        raise CommandError(command, result.returncode)
    return result.stdout.strip()


def checkout_commit() -> str:
    """Return the commit of the loqui checkout running this script."""
    return git_output(["rev-parse", "HEAD"])


def is_checkout() -> bool:
    """Tell whether loqui runs from a git checkout rather than an installed copy."""
    return (LOQUI_ROOT / ".git").exists()


def pin_sources(config: TOMLDocument, source_names: list[str]) -> None:
    """Bind SOURCE_NAMES in CONFIG to the commit of the loqui checkout running this script."""
    commit = checkout_commit()
    for name in source_names:
        source = config["sources"][name]
        for key in REF_KEYS:
            source.pop(key, None)
        source["rev"] = commit


def local_overlay(project: Path, source_names: list[str]) -> None:
    """Point SOURCE_NAMES at the HEAD of the local loqui checkout through `phora.local.toml`."""
    if not is_checkout():
        raise NotACheckoutError
    commit = checkout_commit()
    path = project / "phora.local.toml"
    overlay = read_document(path)
    sources = overlay.setdefault("sources", tomlkit.table())
    for name in source_names:
        layer = name.removeprefix(SOURCE_PREFIX)
        entry = tomlkit.inline_table()
        entry.update({"path": str(LOQUI_ROOT), "root": f"blueprints/{layer}", "rev": commit})
        sources[name] = entry
    path.write_text(tomlkit.dumps(overlay), encoding="utf-8")


def copy_scaffold(project: Path, layer: str) -> None:
    """Copy LAYER's scaffold files the PROJECT lacks."""
    scaffold = BLUEPRINTS / layer / "scaffold"
    if not scaffold.is_dir():
        return
    for template in sorted(p for p in scaffold.rglob("*") if p.is_file()):
        destination = project / template.relative_to(scaffold)
        if destination.exists():
            continue
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(template, destination)


def pkl_name(layer: str) -> str:
    """Return the Pkl identifier LAYER's gate module is imported as."""
    head, *rest = layer.split("-")
    return head + "".join(part.capitalize() for part in rest)


def hk_config(layers: tuple[str, ...]) -> str:
    """Return an `hk.pkl` composing the gates of LAYERS."""

    def imported(layer: str) -> str:
        alias = pkl_name(layer)
        suffix = "" if alias == layer else f" as {alias}"
        return f'import ".loqui/hk/{layer}.pkl"{suffix}'

    def merged(field: str) -> str:
        spreads = "; ".join(f"...{pkl_name(layer)}.{field}" for layer in layers)
        return f"new Mapping<String, Step> {{ {spreads} }}"

    return (
        f'amends "{HK_CONFIG}"\n'
        f'import ".loqui/hk/gate.pkl"\n'
        f"{chr(10).join(imported(layer) for layer in layers)}\n\n"
        f"hooks = gate.standard(\n"
        f"  {merged('fast')},\n"
        f"  {merged('heavy')},\n"
        f"  {merged('fixers')}\n"
        f")\n"
    )


def write_hk_config(project: Path, before: tuple[str, ...], layers: tuple[str, ...]) -> str | None:
    """Write `hk.pkl` for LAYERS unless the project edited the one loqui wrote for BEFORE.

    Return a note when the project's own `hk.pkl` is kept.
    """
    path = project / "hk.pkl"
    if path.exists():
        current = path.read_text(encoding="utf-8")
        if current == hk_config(layers):
            return None
        if not before or current != hk_config(before):
            return f"kept edited {path}; compose it from .loqui/hk/gate.pkl by hand"
    path.write_text(hk_config(layers), encoding="utf-8")
    return None


def run(command: list[str], project: Path) -> None:
    """Run COMMAND in PROJECT, raising when it fails."""
    result = subprocess.run(command, cwd=project, check=False)
    if result.returncode != 0:
        raise CommandError(command, result.returncode)


def tool_version(layer: str, tool: str) -> str:
    """Return the version of TOOL that LAYER's blueprint pins in mise."""
    return str(read_document(BLUEPRINTS / layer / "mise.toml")["tools"][tool])


def prepare_release(project: Path) -> None:
    """Pin PROJECT's cargo-dist, add Cargo's `dist` profile, and generate the workflow."""
    dist_path = project / "dist-workspace.toml"
    dist = read_document(dist_path)
    dist.setdefault("dist", tomlkit.table())["cargo-dist-version"] = tool_version(
        "rust-release", "cargo-dist"
    )
    dist_path.write_text(tomlkit.dumps(dist), encoding="utf-8")

    manifest_path = project / "Cargo.toml"
    manifest = read_document(manifest_path)
    profiles = manifest.setdefault("profile", tomlkit.table(is_super_table=True))
    if "dist" not in profiles:
        profile = tomlkit.table()
        profile.update({"inherits": "release", "lto": "thin"})
        profiles["dist"] = profile
        manifest_path.write_text(tomlkit.dumps(manifest), encoding="utf-8")

    run(["mise", "exec", "--", "dist", "generate"], project)


def reconcile(project: Path, request: Request) -> list[str]:
    """Bind PROJECT to its blueprints at this runner's commit; return notes for the user."""
    notes: list[str] = []
    variables = detected_variables(project) | request.variables
    config_path = project / "phora.toml"
    config = read_document(config_path)

    before = bound_layers(config)
    layers = tuple(dict.fromkeys((*before, *request.layers)))
    if not layers:
        raise NotBoundError
    source_names = [f"{SOURCE_PREFIX}{layer}" for layer in ("common", *layers)]
    clear_loqui(config)
    for layer in ("common", *layers):
        fragment = read_document(BLUEPRINTS / layer / "phora.toml")
        merge_fragment(config, fragment, variables)
    if is_checkout():
        pin_sources(config, source_names)
    config_path.write_text(dump_tidy(config), encoding="utf-8")

    if request.local:
        local_overlay(project, source_names)

    for layer in layers:
        copy_scaffold(project, layer)
    if note := write_hk_config(project, before, layers):
        notes.append(note)

    run(["phora", "sync"], project)
    run(["mise", "trust", "--quiet", str(project)], project)
    run(["mise", "install", "--quiet"], project)
    if "rust-release" in layers:
        prepare_release(project)

    added = set(layers) - set(before)
    if "elisp" in added:
        notes.append(
            'add to Eask: (load (expand-file-name ".loqui/elisp/strict.el" '
            "(file-name-directory load-file-name)) nil t)"
        )
    if "zig" in added:
        notes.append('add to build.zig: @import(".loqui/zig/check.zig").addChecks(b, root_module);')
    return notes


def merge_lints(request: MergeLintsRequest) -> int:
    """Run the lint-table reconciliation on the current directory; return its exit status."""
    command = [str(MERGE_LINTS), *(["--check"] if request.check else [])]
    return subprocess.run(command, check=False).returncode


def main() -> int:
    """Run the requested loqui command on the current directory."""
    try:
        request = parse_request(sys.argv[1:])
        if isinstance(request, MergeLintsRequest):
            return merge_lints(request)
        notes = reconcile(Path.cwd(), request)
    except InitError as error:
        sys.stderr.write(f"loqui: {error}\n")
        return 1
    for note in notes:
        sys.stdout.write(f"loqui: {note}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
