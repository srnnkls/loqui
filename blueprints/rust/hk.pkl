import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"

local rustGlob = List("**/*.rs", "**/Cargo.toml", "Cargo.lock", ".loqui/rust/lints.toml")

fast: Mapping<String, Config.Step> = new {
  ["rust-lints"] {
    glob = rustGlob
    check = "mise run loqui merge-lints --check"
    fix = "mise run loqui merge-lints"
  }
  ["rust-fmt"] {
    glob = rustGlob
    check = "cargo fmt --all --check"
    fix = "cargo fmt --all"
  }
  ["rust-clippy"] {
    glob = rustGlob
    check = "cargo clippy --workspace --all-targets -- -D warnings"
  }
}

heavy: Mapping<String, Config.Step> = new {
  ["rust-test"] {
    glob = rustGlob
    check = "cargo test --workspace"
  }
}

fixers: Mapping<String, Config.Step> = new {
  ["rust-lints"] = (fast["rust-lints"]) { check = null }
  ["rust-fmt"] = (fast["rust-fmt"]) { check = null }
}
